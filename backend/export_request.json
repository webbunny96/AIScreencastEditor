{
  "job_id": "a9a51c03-c86d-4f4c-96be-bf454468ac6e",
  "segments": [
    {"id": 1, "start": 0.88, "end": 6.7, "text": "Привіт, це буде воднорук для нашого курсу.", "keep": true},
    {"id": 2, "start": 7.56, "end": 12.82, "text": "Нало, що йому SSH ключ.", "keep": true},
    {"id": 3, "start": 13.26, "end": 21.38, "text": "І в подальшому мати можливість.", "keep": true},
    {"id": 4, "start": 21.38, "end": 23.74, "text": "Що ж, давайте почнемо.", "keep": false},
    {"id": 5, "start": 24.36, "end": 29.22, "text": "Надескаємося на пашоку воду.", "keep": true},
    {"id": 6, "start": 30.0, "end": 41.64, "text": "І у нас переведе сюди.", "keep": true},
    {"id": 7, "start": 42.48, "end": 44.84, "text": "Пароль використаємо цей.", "keep": true},
    {"id": 8, "start": 48.04, "end": 59.3, "text": "Так, юзерний, давайте просто буде кейсфаст.", "keep": true},
    {"id": 9, "start": 60.5, "end": 66.02, "text": "Це можна інтескати.", "keep": true},
    {"id": 10, "start": 71.26, "end": 74.02, "text": "Так, крієй така уншові.", "keep": true},
    {"id": 11, "start": 74.64, "end": 76.76, "text": "Так, трошечко, зараз перемістимайся.", "keep": false},
    {"id": 12, "start": 77.74, "end": 80.66, "text": "Тепер відкрываю на нашу пошту.", "keep": true}
  ],
  "settings": {
    "resolution": "720p",
    "codec": "libx264",
    "crf": 23,
    "framerate": "30"
  }
}